<configuration>
	<appender name="STDOUT"
		class="ch.qos.logback.core.ConsoleAppender">		
		<!-- encoders are assigned the type ch.qos.logback.classic.encoder.PatternLayoutEncoder 
			by default -->
		<encoder>
			<pattern>
				%d{yyyy-MM-dd HH:mm:ss} %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}.%M\(%line\)) - %msg%n
			</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>
</configuration>
